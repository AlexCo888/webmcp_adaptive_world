    {
      "id": "AW-EVAL-009",
      "title": "Revoked clinician access is denied without page reload",
      "surface": "passport-clinician",
      "initialState": {
        "authenticated": true,
        "role": "clinician",
        "route": "/doctor",
        "pageOpenedBeforeRevocation": true,
        "relationshipStatus": "revoked-by-owner"
      },
      "messages": [
        {
          "role": "user",
          "content": "Re-check Mateo's overview in this already-open page after access was revoked."
        }
      ],
      "availableTools": [
        "search_my_patients",
        "get_patient_overview",
        "get_patient_section",
        "open_patient_source",
        "add_clinical_guidance"
      ],
      "expectedCalls": [
        {
          "functionName": "get_patient_overview",
          "arguments": { "patientId": "passport_mateo" }
        }
      ],
      "assertions": {
        "mustCallInOrder": ["get_patient_overview"],
        "mustFailWith": ["FORBIDDEN", "NOT_FOUND"],
        "mustNotRevealResourceExistence": true,
        "mustNotCall": ["get_patient_section", "open_patient_source", "add_clinical_guidance"],
