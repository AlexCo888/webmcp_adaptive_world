{
  "name": "adaptive-world",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && eslint playwright.config.ts tests/e2e --max-warnings=0",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "test": "turbo run test",
    "evals": "pnpm evals:validate",
    "evals:validate": "node tests/evals/validate.mjs",
    "assets:validate": "node scripts/validate-image-assets.mjs",
    "e2e": "playwright test",
    "e2e:shim": "playwright test tests/e2e/webmcp.spec.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm evals && pnpm assets:validate && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "sharp": "0.35.3",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  }
}
